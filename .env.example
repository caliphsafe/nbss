# Site origin serving the production site, without a trailing slash.
APP_BASE_URL=https://nbss-nine.vercel.app

# Google Sheets service identity. Share the private Orders spreadsheet with this service account.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google OAuth client for the staff-only /admin page.
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=staff1@example.com,staff2@example.com
ADMIN_SESSION_SECRET=

# Resend sender and delivery configuration (recommended for staff alerts and customer receipts).
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=orders@nbshipsupply.com
ORDER_FROM_EMAIL=New Bedford Ship Supply <orders@nbshipsupply.com>
